---
import '../styles/app.css';
import { ClientRouter } from 'astro:transitions';
import AmbientBackground from '../components/AmbientBackground.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body
    class="min-h-screen bg-canvas font-sans text-ink antialiased"
  >
    <span id="page-top" aria-hidden="true"></span>
    <AmbientBackground />
    <Nav pathname={pathname} />
    <main class="relative z-[2]" transition:animate="fade">
      <slot />
    </main>
    <Footer />

    {
      pathname === '/' && (
        <button
          type="button"
          data-scroll-toggle
          class="fixed inset-x-0 bottom-[calc(4.5rem_+_env(safe-area-inset-bottom))] z-50 mx-auto grid h-12 w-12 touch-manipulation place-items-center rounded-full border border-line bg-white/85 text-ink-mute shadow-soft transition-all duration-300 ease-gentle active:scale-95 hover:text-ink sm:bottom-7"
          aria-label="向下滚动查看最近内容"
        >
          <svg
            data-scroll-icon
            class="h-6 w-6 transition-transform duration-300 ease-gentle"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>
      )
    }

    <script is:inline>
      function initReveal() {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var nodes = document.querySelectorAll('.reveal:not(.is-visible)');

        if (reduce || !('IntersectionObserver' in window)) {
          nodes.forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );

        nodes.forEach(function (el) {
          observer.observe(el);
        });
      }

      document.addEventListener('astro:page-load', initReveal);
    </script>

    <script>
      function getScrollTop() {
        return (
          window.scrollY ||
          document.documentElement.scrollTop ||
          document.body.scrollTop ||
          0
        );
      }

      function isScrolledDown() {
        return getScrollTop() > 40;
      }

      function scrollToSection(id: string) {
        const el = document.getElementById(id);
        if (!el) return;
        try {
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch {
          el.scrollIntoView();
        }
      }

      function updateScrollToggle() {
        const button = document.querySelector<HTMLElement>(
          '[data-scroll-toggle]'
        );
        if (!button) return;
        const icon = button.querySelector<SVGElement>('[data-scroll-icon]');
        const down = isScrolledDown();

        button.setAttribute(
          'aria-label',
          down ? '回到顶部' : '向下滚动查看最近内容'
        );
        if (icon) icon.style.transform = down ? 'rotate(180deg)' : '';
      }

      function initScrollToggle() {
        updateScrollToggle();
      }

      document.addEventListener('click', (event) => {
        const target = event.target as Element | null;
        const button = target?.closest('[data-scroll-toggle]');
        if (!button) return;
        event.preventDefault();
        scrollToSection(isScrolledDown() ? 'page-top' : 'recent');
      });

      document.addEventListener(
        'touchend',
        (event) => {
          const target = event.target as Element | null;
          const button = target?.closest('[data-scroll-toggle]');
          if (!button) return;
          event.preventDefault();
          scrollToSection(isScrolledDown() ? 'page-top' : 'recent');
        },
        { passive: false }
      );

      window.addEventListener('scroll', updateScrollToggle, { passive: true });
      window.addEventListener('resize', updateScrollToggle);
      document.addEventListener('astro:page-load', initScrollToggle);
      initScrollToggle();
    </script>
  </body>
</html>
