---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="reveal mb-[clamp(2.5rem,6vw,4.5rem)]">
  <p class="text-[0.72rem] uppercase tracking-[0.24em] text-ink-mute">
    {eyebrow}
  </p>
  <h1
    class="mt-3 text-[clamp(2rem,1.4rem_+_3vw,3.4rem)] font-medium leading-[1.15] tracking-[-0.02em]"
  >
    {title}
  </h1>
  {
    description && (
      <p
        class="mt-4 max-w-[42rem] text-[clamp(1.05rem,0.98rem_+_0.4vw,1.3rem)] leading-[1.7] text-ink-soft"
      >
        {description}
      </p>
    )
  }
</header>
