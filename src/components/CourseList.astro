---
import type { CollectionEntry } from 'astro:content';
import MediaPlaceholder from './MediaPlaceholder.astro';
import { formatDate } from '../lib/content';

interface Props {
  entries: CollectionEntry<'course'>[];
}

const { entries } = Astro.props;
---

<ul class="grid grid-cols-1 gap-[clamp(1.25rem,3vw,2rem)] sm:grid-cols-2">
  {
    entries.map((entry, i) => (
      <li class="reveal" style={`--reveal-delay:${i * 80}ms`}>
        <a
          href={`/course/${entry.id}`}
          class="group flex h-full flex-col overflow-hidden rounded-card border border-line bg-white/60 shadow-soft backdrop-blur-md transition-all duration-500 ease-gentle hover:-translate-y-1.5 hover:shadow-glow"
        >
          <div class="aspect-[16/9] w-full overflow-hidden bg-tint">
            {entry.data.cover ? (
              <img
                src={entry.data.cover}
                alt={entry.data.title}
                class="h-full w-full object-cover transition-transform duration-700 ease-gentle group-hover:scale-[1.03]"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <MediaPlaceholder label="课程" />
            )}
          </div>
          <div class="flex flex-1 flex-col p-[clamp(1.1rem,2.4vw,1.5rem)]">
            <div class="flex items-center justify-between gap-3 text-[0.72rem] uppercase tracking-[0.16em] text-ink-mute">
              <span>{entry.data.category}</span>
              <span class="tabular-nums">{formatDate(entry.data.date)}</span>
            </div>
            <h2 class="mt-2 text-[1.05rem] font-medium tracking-[-0.01em] transition-colors duration-300 group-hover:text-accent-strong">
              {entry.data.title}
            </h2>
            {entry.data.description && (
              <p class="mt-2 text-[0.95rem] leading-[1.75] text-ink-soft">
                {entry.data.description}
              </p>
            )}
          </div>
        </a>
      </li>
    ))
  }
</ul>
