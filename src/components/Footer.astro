---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="relative z-[1] mt-[clamp(3rem,8vw,6rem)] border-t border-line">
  <div
    class="mx-auto flex w-full max-w-[66rem] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-[clamp(1.25rem,5vw,3.5rem)] py-[clamp(2rem,5vw,3.25rem)]"
  >
    <p class="text-[0.85rem] text-ink-mute">© {year} {site.name}</p>
    <p class="text-[0.85rem] text-ink-mute/70">以 Astro 安静地搭建。</p>
  </div>
</footer>
