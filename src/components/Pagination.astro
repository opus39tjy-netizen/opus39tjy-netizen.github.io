---
interface Props {
  current: number;
  total: number;
  base: string;
}

const { current, total, base } = Astro.props;
const hrefFor = (n: number) => (n === 1 ? `${base}/` : `${base}/page/${n}/`);
const pages = Array.from({ length: total }, (_, i) => i + 1);
---

{
  total > 1 && (
    <nav
      class="mt-[clamp(2rem,5vw,3rem)] flex flex-wrap items-center justify-center gap-2"
      aria-label="分页"
    >
      {current > 1 && (
        <a
          href={hrefFor(current - 1)}
          class="rounded-full border border-line px-4 py-1.5 text-[0.9rem] text-ink-soft transition-colors duration-300 ease-gentle hover:text-ink"
        >
          上一页
        </a>
      )}
      {pages.map((n) => (
        <a
          href={hrefFor(n)}
          class:list={[
            'grid h-9 w-9 place-items-center rounded-full text-[0.9rem] transition-colors duration-300 ease-gentle',
            n === current
              ? 'bg-accent/15 text-ink'
              : 'text-ink-soft hover:bg-accent/10 hover:text-ink',
          ]}
          aria-current={n === current ? 'page' : undefined}
        >
          {n}
        </a>
      ))}
      {current < total && (
        <a
          href={hrefFor(current + 1)}
          class="rounded-full border border-line px-4 py-1.5 text-[0.9rem] text-ink-soft transition-colors duration-300 ease-gentle hover:text-ink"
        >
          下一页
        </a>
      )}
    </nav>
  )
}
