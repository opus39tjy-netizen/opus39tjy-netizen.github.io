---
import { nav, site } from '../data/site';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header
  class="sticky top-0 z-20 border-b border-line/70 bg-canvas/75 backdrop-blur-xl backdrop-saturate-150"
>
  <div
    class="mx-auto flex w-full max-w-[66rem] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-[clamp(1.25rem,5vw,3.5rem)] py-[0.95rem]"
  >
    <a href="/" class="group inline-flex items-center gap-2.5">
      <span
        class="h-[0.7rem] w-[0.7rem] rounded-full bg-[linear-gradient(135deg,#c9c2e8,#aec7e0_55%,#b8dde3)] ring-4 ring-[rgba(174,199,224,0.16)] transition-transform duration-700 ease-gentle group-hover:scale-125"
        aria-hidden="true"></span>
      <span
        class="text-[0.95rem] font-medium tracking-wide transition-colors duration-300 ease-gentle group-hover:text-accent-strong"
        >{site.name}</span
      >
    </a>

    <nav aria-label="主导航">
      <ul class="flex flex-wrap items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                class:list={[
                  'inline-block rounded-full px-2.5 py-1.5 text-[0.9rem] transition-all duration-300 ease-gentle',
                  isActive(item.href)
                    ? 'bg-accent/10 text-ink'
                    : 'text-ink-soft hover:bg-accent/10 hover:text-ink',
                ]}
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
