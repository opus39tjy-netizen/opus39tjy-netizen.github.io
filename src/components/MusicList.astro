---
import type { CollectionEntry } from 'astro:content';
import MediaPlaceholder from './MediaPlaceholder.astro';
import { formatDate } from '../lib/content';

interface Props {
  entries: CollectionEntry<'music'>[];
}

const { entries } = Astro.props;
---

<ul class="border-t border-line">
  {
    entries.map((entry, i) => (
      <li class="reveal border-b border-line" style={`--reveal-delay:${i * 70}ms`}>
        <a
          href={`/music/${entry.id}`}
          class="group flex items-start gap-4 py-[clamp(1.05rem,3vw,1.6rem)] transition-transform duration-500 ease-gentle hover:translate-x-1.5 sm:gap-5"
        >
          <div class="relative h-16 w-16 shrink-0 overflow-hidden rounded-sm bg-tint sm:h-20 sm:w-20">
            {entry.data.cover ? (
              <img
                src={entry.data.cover}
                alt={entry.data.title}
                class="h-full w-full object-cover transition-transform duration-700 ease-gentle group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <MediaPlaceholder label="音乐" />
            )}
            {entry.data.video && (
              <span
                class="pointer-events-none absolute inset-0 grid place-items-center"
                aria-hidden="true"
              >
                <span class="grid h-7 w-7 place-items-center rounded-full bg-white/80 text-accent-strong shadow-soft">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5.14v13.72a.5.5 0 0 0 .76.43l11-6.86a.5.5 0 0 0 0-.86l-11-6.86A.5.5 0 0 0 8 5.14Z" />
                  </svg>
                </span>
              </span>
            )}
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <span class="text-[clamp(1rem,0.94rem_+_0.4vw,1.15rem)] font-medium tracking-[-0.01em] transition-colors duration-300 group-hover:text-accent-strong">
                {entry.data.title}
              </span>
              <span class="whitespace-nowrap text-[0.85rem] tabular-nums text-ink-mute">
                {entry.data.category} · {formatDate(entry.data.date)}
              </span>
            </div>
            {entry.data.artist && (
              <p class="mt-1 text-[0.85rem] text-ink-mute">{entry.data.artist}</p>
            )}
            {entry.data.description && (
              <p class="mt-1 max-w-[42rem] text-[0.95rem] text-ink-soft">
                {entry.data.description}
              </p>
            )}
            {entry.data.tags.length > 0 && (
              <span class="mt-2 flex flex-wrap gap-2">
                {entry.data.tags.map((tag) => (
                  <span class="rounded-full bg-accent/10 px-3 py-1 text-[0.7rem] uppercase tracking-[0.14em] text-accent-strong">
                    {tag}
                  </span>
                ))}
              </span>
            )}
          </div>
        </a>
      </li>
    ))
  }
</ul>
