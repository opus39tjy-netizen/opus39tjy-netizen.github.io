---
interface Track {
  title: string;
  artist?: string;
  src: string;
}

interface Props {
  tracks: Track[];
}

const { tracks } = Astro.props;
---

<div class="reveal" data-player>
  <div
    class="relative overflow-hidden rounded-lg border border-line bg-white/60 p-[clamp(1.25rem,3vw,1.9rem)] shadow-soft backdrop-blur-md"
  >
    <div
      class="pointer-events-none absolute -right-16 -top-20 h-52 w-52 rounded-full bg-mist-violet/30 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative flex items-center gap-4">
      <button
        type="button"
        data-toggle
        aria-label="播放"
        class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-line bg-white/70 text-accent-strong shadow-soft transition-all duration-300 ease-gentle hover:-translate-y-0.5 hover:shadow-glow"
      >
        <svg
          data-icon-play
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 5.14v13.72a.5.5 0 0 0 .76.43l11-6.86a.5.5 0 0 0 0-.86l-11-6.86A.5.5 0 0 0 8 5.14Z"
          ></path>
        </svg>
        <svg
          data-icon-pause
          class="hidden"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <rect x="6" y="5" width="4" height="14" rx="1.2"></rect>
          <rect x="14" y="5" width="4" height="14" rx="1.2"></rect>
        </svg>
      </button>

      <div class="min-w-0 flex-1">
        <p data-title class="truncate text-[1.02rem] font-medium text-ink">—</p>
        <p data-artist class="truncate text-[0.85rem] text-ink-mute">—</p>
      </div>

      <span
        data-time
        class="shrink-0 text-[0.8rem] tabular-nums text-ink-mute">0:00 / 0:00</span
      >
    </div>

    <div
      data-progress
      class="relative mt-5 h-1.5 w-full cursor-pointer rounded-full bg-line"
    >
      <div
        data-bar
        class="absolute inset-y-0 left-0 w-0 rounded-full bg-[linear-gradient(90deg,#aec7e0,#c9c2e8)]"
      >
      </div>
    </div>

    <ul data-list class="mt-5 space-y-1 border-t border-line pt-3">
      {
        tracks.map((track, i) => (
          <li>
            <button
              type="button"
              data-track={i}
              data-src={track.src}
              data-title={track.title}
              data-artist={track.artist ?? ''}
              class="flex w-full items-center gap-3 rounded-sm px-2.5 py-2 text-left transition-colors duration-300 ease-gentle hover:bg-accent/10"
            >
              <span class="w-4 shrink-0 text-[0.78rem] tabular-nums text-ink-mute">
                {i + 1}
              </span>
              <span class="min-w-0 flex-1 truncate text-[0.95rem] text-ink-soft">
                {track.title}
              </span>
              <span class="shrink-0 text-[0.78rem] text-ink-mute">
                {track.artist}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <audio data-audio preload="metadata"></audio>
</div>

<style>
  [data-track].is-active {
    background: var(--accent-wash);
  }

  [data-track].is-active span {
    color: var(--text);
  }
</style>

<script>
  function initPlayers() {
    document.querySelectorAll<HTMLElement>('[data-player]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const audio = root.querySelector<HTMLAudioElement>('[data-audio]');
      const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
      const iconPlay = root.querySelector<SVGElement>('[data-icon-play]');
      const iconPause = root.querySelector<SVGElement>('[data-icon-pause]');
      const bar = root.querySelector<HTMLElement>('[data-bar]');
      const progress = root.querySelector<HTMLElement>('[data-progress]');
      const time = root.querySelector<HTMLElement>('[data-time]');
      const titleEl = root.querySelector<HTMLElement>('[data-title]');
      const artistEl = root.querySelector<HTMLElement>('[data-artist]');
      const buttons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-track]')
      );

      if (!audio || !toggle || !bar || !progress || !time) return;

      let current = -1;

      const fmt = (value: number) => {
        if (!isFinite(value)) return '0:00';
        const m = Math.floor(value / 60);
        const s = Math.floor(value % 60)
          .toString()
          .padStart(2, '0');
        return `${m}:${s}`;
      };

      const update = () => {
        const duration = audio.duration || 0;
        const position = audio.currentTime || 0;
        bar.style.width = (duration ? (position / duration) * 100 : 0) + '%';
        time.textContent = `${fmt(position)} / ${fmt(duration)}`;
        const playing = !audio.paused && !audio.ended;
        iconPlay?.classList.toggle('hidden', playing);
        iconPause?.classList.toggle('hidden', !playing);
        toggle.setAttribute('aria-label', playing ? '暂停' : '播放');
      };

      const select = (index: number, autoplay: boolean) => {
        const button = buttons[index];
        if (!button) return;
        current = index;
        audio.src = button.dataset.src ?? '';
        if (titleEl) titleEl.textContent = button.dataset.title ?? '';
        if (artistEl) artistEl.textContent = button.dataset.artist ?? '';
        buttons.forEach((item, i) =>
          item.classList.toggle('is-active', i === index)
        );
        if (autoplay) audio.play().catch(() => {});
        update();
      };

      toggle.addEventListener('click', () => {
        if (current === -1) {
          select(0, true);
        } else if (audio.paused) {
          audio.play().catch(() => {});
        } else {
          audio.pause();
        }
      });

      buttons.forEach((button, index) => {
        button.addEventListener('click', () => {
          if (index === current) {
            if (audio.paused) audio.play().catch(() => {});
            else audio.pause();
          } else {
            select(index, true);
          }
        });
      });

      progress.addEventListener('click', (event) => {
        if (!audio.duration) return;
        const rect = progress.getBoundingClientRect();
        const ratio = Math.min(
          1,
          Math.max(0, (event.clientX - rect.left) / rect.width)
        );
        audio.currentTime = ratio * audio.duration;
        update();
      });

      audio.addEventListener('timeupdate', update);
      audio.addEventListener('loadedmetadata', update);
      audio.addEventListener('play', update);
      audio.addEventListener('pause', update);
      audio.addEventListener('ended', update);

      if (buttons.length > 0) select(0, false);
    });
  }

  document.addEventListener('astro:page-load', initPlayers);
  initPlayers();
</script>
