---
interface Props {
  label: string;
}

const { label } = Astro.props;

const icons: Record<string, string> = {
  课程: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  文章:
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
  音乐:
    '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
};

const icon = icons[label] ?? '<circle cx="12" cy="12" r="9"/>';
---

<div class="media-placeholder grid h-full w-full place-items-center">
  <span
    class="grid h-10 w-10 place-items-center rounded-full bg-white/60 shadow-[0_1px_6px_rgba(43,47,54,0.06)]"
  >
    <svg
      class="h-[1.2rem] w-[1.2rem] text-ink/75"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={icon}
    />
  </span>
</div>
