---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('works', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'works'> };
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={entry.data.category}
  date={entry.data.date}
  tags={entry.data.tags}
  cover={entry.data.cover}
  comments={true}
>
  <div slot="links" class="reveal mb-10 flex flex-col gap-4">
    {
      entry.data.video && (
        <video controls preload="metadata" src={entry.data.video} class="w-full">
          你的浏览器不支持视频播放。
        </video>
      )
    }

    {
      entry.data.links.length > 0 && (
        <ul class="flex flex-wrap gap-3">
          {entry.data.links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white/60 px-4 py-1.5 text-[0.85rem] text-accent-strong transition-all duration-300 ease-gentle hover:-translate-y-0.5 hover:shadow-soft"
              >
                {link.label}
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <Content />
</ContentLayout>
