---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import WritingList from '../../components/WritingList.astro';
import Pagination from '../../components/Pagination.astro';
import { getWriting, PAGE_SIZE } from '../../lib/content';

const posts = await getWriting();
const total = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const paged = posts.slice(0, PAGE_SIZE);
---

<BaseLayout
  title="文章"
  description="技术思考、生物医学工程、学习记录，以及一些更安静的随笔。"
>
  <section
    class="mx-auto w-full max-w-[66rem] px-[clamp(1.25rem,5vw,3.5rem)] pb-[clamp(4.5rem,11vw,9.5rem)] pt-[clamp(2.5rem,6vw,4rem)]"
  >
    <PageHead title="文章" />

    {paged.length > 0 && <WritingList posts={paged} />}

    <Pagination current={1} total={total} base="/writing" />
  </section>
</BaseLayout>
