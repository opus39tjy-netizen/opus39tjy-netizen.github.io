---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getRecent, formatDate } from '../lib/content';

const recent = await getRecent(4);
---

<BaseLayout>
  <section
    class="mx-auto w-full max-w-[66rem] px-[clamp(1.25rem,5vw,3.5rem)] pb-[clamp(2rem,5vw,3rem)] pt-[clamp(4rem,10vw,7rem)] text-center"
  >
    <h1
      class="reveal text-[clamp(1.9rem,1.2rem_+_3vw,3rem)] font-medium leading-[1.2] tracking-[-0.02em]"
    >
      {site.heading}
    </h1>
    {
      site.tagline && (
        <p
          class="reveal mt-4 text-[0.72rem] uppercase tracking-[0.24em] text-ink-mute"
          style="--reveal-delay:120ms"
        >
          {site.tagline}
        </p>
      )
    }
  </section>

  <section
    class="mx-auto w-full max-w-[56rem] px-[clamp(1.25rem,5vw,3.5rem)] pb-[clamp(4rem,10vw,8rem)] pt-[clamp(1rem,3vw,2rem)]"
  >
    <div
      class="reveal mb-[clamp(1.25rem,3vw,2rem)] flex items-baseline justify-between gap-6"
    >
      <p class="text-[0.72rem] uppercase tracking-[0.24em] text-ink-mute">最近</p>
      <a
        class="text-[0.9rem] text-ink-soft transition-colors duration-300 ease-gentle hover:text-accent-strong"
        href="/writing">全部文章</a
      >
    </div>

    {
      recent.length > 0 ? (
        <ul class="reveal border-t border-line">
          {recent.map((item) => (
            <li class="border-b border-line">
              <a
                href={item.href}
                class="group grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 py-[clamp(1.05rem,3vw,1.6rem)] transition-transform duration-500 ease-gentle hover:translate-x-1.5"
              >
                <span class="text-[clamp(1.05rem,0.98rem_+_0.5vw,1.3rem)] font-medium tracking-[-0.01em] transition-colors duration-300 group-hover:text-accent-strong">
                  {item.title}
                </span>
                <span class="whitespace-nowrap text-[0.85rem] tabular-nums text-ink-mute">
                  {item.category} · {formatDate(item.date)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : null
    }
  </section>
</BaseLayout>
