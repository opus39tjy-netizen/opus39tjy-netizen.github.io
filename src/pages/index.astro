---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site } from '../data/site';
import { getRecent, formatDate } from '../lib/content';

const recent = await getRecent(4);

function resolveHref(href: string) {
  const h = (href ?? '').trim();
  if (/^(https?:|mailto:|tel:)/i.test(h)) return h;
  if (/^\d+$/.test(h)) return `https://wpa.qq.com/msgrd?v=3&uin=${h}&site=qq&menu=yes`;
  if (h.includes('@')) return `mailto:${h}`;
  return h ? `https://${h}` : '#';
}

const socials = (site.socials ?? []).map((social) => ({
  label: social.label,
  href: resolveHref(social.href),
}));
---

<BaseLayout>
  <section
    class="relative isolate flex min-h-[calc(100svh-4.5rem)] flex-col items-center justify-center overflow-hidden px-[clamp(1.25rem,5vw,3.5rem)] py-[clamp(3rem,8vw,6rem)] text-center"
  >
    {
      site.heroImage && (
        <img
          src={site.heroImage}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 z-0 h-full w-full object-cover"
        />
      )
    }
    <div
      class="absolute inset-0 z-10 bg-[linear-gradient(to_bottom,rgba(250,251,252,0.72),rgba(250,251,252,0.45)_55%,rgba(250,251,252,0.82))]"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-20 flex flex-col items-center">
      <h1
        class="reveal text-[clamp(2rem,1.3rem_+_3.2vw,3.4rem)] font-medium leading-[1.15] tracking-[-0.02em]"
      >
        {site.heading}
      </h1>
      {
        site.tagline && (
          <p
            class="reveal mt-4 text-[0.72rem] uppercase tracking-[0.24em] text-ink-mute"
            style="--reveal-delay:120ms"
          >
            {site.tagline}
          </p>
        )
      }

      {
        socials.length > 0 && (
          <ul
            class="reveal mt-8 flex flex-wrap items-center justify-center gap-3"
            style="--reveal-delay:200ms"
          >
            {socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel={
                    social.href.startsWith('http')
                      ? 'noopener noreferrer'
                      : undefined
                  }
                  aria-label={social.label}
                  title={social.label}
                  class="grid h-11 w-11 place-items-center rounded-full border border-white/50 bg-white/30 text-ink shadow-soft backdrop-blur-md transition-all duration-300 ease-gentle hover:-translate-y-0.5 hover:bg-white/60"
                >
                  <SocialIcon label={social.label} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <button
      type="button"
      data-scroll-toggle
      class="fixed inset-x-0 bottom-[calc(1.75rem_+_env(safe-area-inset-bottom))] z-30 mx-auto grid h-12 w-12 touch-manipulation place-items-center rounded-full border border-line bg-white/70 text-ink-mute shadow-soft backdrop-blur-md transition-all duration-300 ease-gentle active:scale-95 hover:text-ink"
      aria-label="向下滚动查看最近内容"
    >
      <svg
        data-scroll-icon
        class="h-6 w-6 transition-transform duration-300 ease-gentle"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </button>
  </section>

  <section
    id="recent"
    class="mx-auto w-full max-w-[64rem] scroll-mt-24 px-[clamp(1.25rem,5vw,3.5rem)] pb-[clamp(4rem,10vw,8rem)] pt-[clamp(3rem,7vw,5rem)]"
  >
    <div
      class="reveal mb-[clamp(1.25rem,3vw,2rem)] flex items-baseline justify-between gap-6"
    >
      <p class="text-[0.72rem] uppercase tracking-[0.24em] text-ink-mute">最近</p>
      <a
        class="text-[0.9rem] text-ink-soft transition-colors duration-300 ease-gentle hover:text-accent-strong"
        href="/writing">全部文章</a
      >
    </div>

    {
      recent.length > 0 ? (
        <ul class="grid grid-cols-1 gap-[clamp(1rem,2.5vw,1.5rem)] sm:grid-cols-2">
          {recent.map((item, i) => (
            <li class="reveal" style={`--reveal-delay:${i * 70}ms`}>
              <a
                href={item.href}
                class="group flex h-full gap-4 rounded-card border border-line bg-white/60 p-3 shadow-soft backdrop-blur-md transition-all duration-500 ease-gentle hover:-translate-y-1 hover:shadow-glow"
              >
                <div class="h-20 w-20 shrink-0 overflow-hidden rounded-sm bg-tint">
                  {item.cover ? (
                    <img
                      src={item.cover}
                      alt={item.title}
                      class="h-full w-full object-cover transition-transform duration-700 ease-gentle group-hover:scale-105"
                      loading="lazy"
                    />
                  ) : (
                    <div class="h-full w-full bg-[linear-gradient(135deg,#c9c2e8,#aec7e0_55%,#b8dde3)]" />
                  )}
                </div>
                <div class="min-w-0 flex-1 py-1">
                  <div class="text-[0.72rem] uppercase tracking-[0.14em] text-ink-mute">
                    {item.category} · {formatDate(item.date)}
                  </div>
                  <h2 class="mt-1.5 line-clamp-2 text-[1.02rem] font-medium leading-[1.4] tracking-[-0.01em] transition-colors duration-300 group-hover:text-accent-strong">
                    {item.title}
                  </h2>
                  <p class="mt-1 line-clamp-1 text-[0.88rem] text-ink-soft">
                    {item.description}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : null
    }
  </section>
</BaseLayout>

<script>
  function getScrollTop() {
    return (
      window.scrollY ||
      document.documentElement.scrollTop ||
      document.body.scrollTop ||
      0
    );
  }

  function isScrolledDown() {
    return getScrollTop() > 40;
  }

  function scrollToSection(id: string) {
    const el = document.getElementById(id);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function updateScrollToggle() {
    const button = document.querySelector<HTMLElement>('[data-scroll-toggle]');
    if (!button) return;
    const icon = button.querySelector<SVGElement>('[data-scroll-icon]');
    const down = isScrolledDown();

    button.setAttribute(
      'aria-label',
      down ? '回到顶部' : '向下滚动查看最近内容'
    );
    if (icon) icon.style.transform = down ? 'rotate(180deg)' : '';
  }

  function initScrollToggle() {
    const button = document.querySelector<HTMLButtonElement>(
      '[data-scroll-toggle]'
    );
    if (button && button.dataset.ready !== 'true') {
      button.dataset.ready = 'true';
      button.addEventListener('click', () => {
        scrollToSection(isScrolledDown() ? 'page-top' : 'recent');
      });
    }
    updateScrollToggle();
  }

  document.addEventListener('astro:page-load', initScrollToggle);
  window.addEventListener('scroll', updateScrollToggle, { passive: true });
  window.addEventListener('resize', updateScrollToggle);
</script>
