---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import MusicList from '../../../components/MusicList.astro';
import Pagination from '../../../components/Pagination.astro';
import { getMusic, PAGE_SIZE } from '../../../lib/content';

export async function getStaticPaths() {
  const entries = await getMusic();
  const total = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const page = Number(Astro.params.page);
const entries = await getMusic();
const total = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));
const paged = entries.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
---

<BaseLayout
  title={`音乐 · 第 ${page} 页`}
  description="最近在听的东西，以及——以后——自己试着做的音乐。"
>
  <section
    class="mx-auto w-full max-w-[66rem] px-[clamp(1.25rem,5vw,3.5rem)] pb-[clamp(4.5rem,11vw,9.5rem)] pt-[clamp(2.5rem,6vw,4rem)]"
  >
    <PageHead title="音乐" />

    {paged.length > 0 && <MusicList entries={paged} />}

    <Pagination current={page} total={total} base="/music" />
  </section>
</BaseLayout>
